{
  "name": "@damarkuncoro/agnostic-ui-contract-core",
  "version": "0.0.1",
  "description": "Core contract utilities and base types for Agnostic UI",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:clean": "rm -rf lib && npm run build",
    "prepublishOnly": "npm run build && npm run test",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "size": "size-limit",
    "analyze": "npm run build && npx @size-limit/file lib/index.js"
  },
  "keywords": [
    "ui",
    "contracts",
    "agnostic",
    "types",
    "utilities"
  ],
  "author": "Agnostic UI Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "@types/node": "^20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/damarkuncoro/agnostic-ui-contract-core"
  },
  "bugs": {
    "url": "https://github.com/damarkuncoro/agnostic-ui-contract-core/issues"
  },
  "homepage": "https://github.com/damarkuncoro/agnostic-ui-contract-core#readme"
}
